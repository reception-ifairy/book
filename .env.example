# --- AI providers (keys can also be set in the admin panel at /#/admin; a key saved there wins) ---

# Story engine (required): Claude writes every page.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Illustrations and/or narration voice (optional, either or both).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# --- Server ---

# Protects the admin panel. Without it the panel only answers requests from localhost.
ADMIN_PASSWORD="change-me"

# Where config.json (admin-saved keys), stories and generated media are stored.
DATA_DIR="data"

# HTTP port (default 3000).
PORT=3000

# Set behind a reverse proxy / Cloud Run so rate limits see the real client IP (e.g. 1 = trust one hop).
# TRUST_PROXY=1

# APP_URL: injected by AI Studio with the Cloud Run service URL. Not read by the app itself.
APP_URL="MY_APP_URL"
