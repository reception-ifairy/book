# Story engine (required). Can also be set in the admin panel at /#/admin.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Illustrations / narration voice (optional, pick either or both). Also settable in the admin panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Protects the admin panel. Without it the panel only answers requests from localhost.
ADMIN_PASSWORD="change-me"

# Where config.json (admin-saved keys), stories and generated media are stored.
DATA_DIR="data"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
